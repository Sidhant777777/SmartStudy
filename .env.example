# PostgreSQL connection string — Railway sets this automatically
DATABASE_URL=postgresql://user:password@host:port/dbname

# Groq AI — get a free key at console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Gmail email notifications (optional)
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
NOTIFY_EMAIL=you@gmail.com

# JWT secret — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-long-random-secret-key-change-this
